# Google Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model fallback chain (comma separated, tried in order)
# GEMINI_MODEL_CHAIN=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash-lite

# Optional: YouTube Data API v3 key — get one free at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first). Without this, the app
# still works fully — lessons just won't show "watch more" video suggestions.
YOUTUBE_API_KEY=

PORT=8787

# --- Multiplayer (all optional) ---
# How long a clan war lasts, in minutes (default 1440 = 24h). Use 5 while testing.
# WAR_DURATION_MIN=1440
# Where players/clans are saved (default server/data/store.json)
# GYAN_STORE_FILE=

# Demo only: if set to 1, battle questions may fall back to a generic built-in bank that is NOT
# the student's material. Leave unset for real play.
# GYAN_DEMO_QUESTIONS=1
